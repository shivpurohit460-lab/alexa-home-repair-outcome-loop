{
  "name": "AlexaOutcomeLoop",
  "version": 1,
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "AlexaOutcomeLoop",
    "Project": "AmazonDeveloperHackathon2026"
  },
  "runtimes": [
    {
      "name": "OutcomeLoopAgent",
      "build": "CodeZip",
      "entrypoint": "agentcore_entrypoint.py",
      "codeLocation": ".",
      "runtimeVersion": "PYTHON_3_13",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "global.anthropic.claude-sonnet-4-6"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-south-1"
        }
      ],
      "instrumentation": {
        "enableOtel": true
      }
    }
  ],
  "memories": [],
  "credentials": [],
  "payments": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": []
}
